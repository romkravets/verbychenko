generator client {
  provider = "prisma-client-js"
  // driverAdapters більше не потребує previewFeatures в Prisma 7
}

datasource db {
  provider = "postgresql"
}

model Announcement {
  id           String             @id @default(cuid())
  type         AnnouncementType   @default(DATING)
  // --- Dating fields ---
  name         String
  age          Int                @default(0)
  city         String
  height       Int?
  weight       Int?
  hairColor    String?
  education    String?
  housing      String?
  about        String             @default("")
  lookingFor   String             @default("")
  // --- Commercial fields ---
  itemTitle    String? // що продається / пропонується
  price        String? // ціна
  contactPhone String? // телефон контакту
  // --- Common ---
  aiText       String?
  status       AnnouncementStatus @default(PENDING)
  audioUrl     String?
  letterNumber Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  queueItems QueueItem[]

  @@map("announcements")
}

model Episode {
  id          String        @id @default(cuid())
  scheduledAt DateTime // коли запускається в ефір
  status      EpisodeStatus @default(DRAFT)
  mp3Url      String? // фінальний зібраний файл
  createdAt   DateTime      @default(now())

  queueItems QueueItem[]

  @@map("episodes")
}

model QueueItem {
  id             String    @id @default(cuid())
  type           QueueType
  audioUrl       String
  order          Int
  playedAt       DateTime?
  episodeId      String
  announcementId String?
  youtubeVideoId String?

  episode      Episode       @relation(fields: [episodeId], references: [id])
  announcement Announcement? @relation(fields: [announcementId], references: [id])
  youtubeVideo YoutubeVideo? @relation(fields: [youtubeVideoId], references: [id])

  @@map("queue_items")
}

model YoutubeVideo {
  id          String   @id @default(cuid())
  videoId     String   @unique
  channelId   String
  channelName String
  title       String
  radioText   String   @db.Text
  audioUrl    String?
  processedAt DateTime @default(now())

  queueItems QueueItem[]

  @@map("youtube_videos")
}

enum AnnouncementStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnnouncementType {
  DATING
  COMMERCIAL
}

enum EpisodeStatus {
  DRAFT
  PUBLISHED
  AIRED
}

enum QueueType {
  MUSIC
  ANNOUNCEMENT
  EDITORIAL
  INTRO
  OUTRO
  NEWS
}
