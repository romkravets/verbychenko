# Database (Supabase / Neon / Railway)
DATABASE_URL="postgresql://user:password@host:5432/verbychenko"
DIRECT_URL="postgresql://user:password@host:5432/verbychenko"

# AI Provider: 'groq' або 'claude'
AI_PROVIDER="groq"
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""

# TTS — Google Cloud Text-to-Speech (HTTP API, works on Vercel — no Python needed)
# Free tier: 1,000,000 chars/month (WaveNet voices). Voice: uk-UA-Wavenet-A
# Get key: console.cloud.google.com → APIs → Cloud Text-to-Speech API → Credentials → API Key
GOOGLE_TTS_API_KEY=""
# Provider selection: google | voicebox
TTS_PROVIDER="google"
# Optional fallback provider if primary fails
TTS_FALLBACK_PROVIDER=""
# Voice profile: classic | natural | warm (used for Google provider)
TTS_PROFILE="natural"
# Optional hard override for Google voice name (e.g. uk-UA-Neural2-A)
GOOGLE_TTS_VOICE=""
# Voicebox HTTP endpoint (optional, used when TTS_PROVIDER=voicebox)
VOICEBOX_TTS_URL=""
# Voice prosody (speaking rate 0.75-1.0, pitch in semitones -5.0 to +5.0)
TTS_RATE="0.85"
TTS_PITCH="0.0"

# Supabase Storage
# URL and anon/publishable key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# SERVICE ROLE KEY — copy from Supabase Dashboard → Project Settings → API → service_role
# Must start with sb_secret_... or eyJ... (JWT). DO NOT use the publishable key here!
# Wrong key causes "row-level security policy" upload errors.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Cloudflare R2 (alternative storage — not required if Supabase is used)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="verbychenko-audio"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# Telegram Bot (moderation — Phase 3)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_MODERATOR_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""

# Episode builder secret (use any random string)
EPISODE_BUILD_SECRET="change-me-random-string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set to a real Episode ID from DB to enable radio player queue
NEXT_PUBLIC_DEMO_EPISODE_ID=""
